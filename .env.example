# Copy this file to .env and fill it in. Never commit .env.
# On Vercel you do NOT use this file: add the same names in Project Settings > Environment Variables.

# Admin login
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Signs the login session. Use a random string of 32+ characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Secret address of the admin, e.g. yoursite.com/my-private-door
VITE_ADMIN_PATH=

# Postgres connection string (from Neon). Vercel fills this in for you when you add Neon.
DATABASE_URL=

# Local only
PORT=3001
