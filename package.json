{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "dev": "concurrently -n server,client \"npm run dev:server\" \"npm run dev --prefix client\"",
    "dev:server": "node --watch server/index.js",
    "build": "npm run build --prefix client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
